{
    "name": "flatrate/flarum-wiki-context",
    "description": "FlatRate.wiki semantic WIKI context projection for Flarum. Source-only package; not authorized for production installation.",
    "type": "flarum-extension",
    "license": "MIT",
    "keywords": [
        "flarum",
        "wiki",
        "context",
        "projection",
        "semantic"
    ],
    "homepage": "https://flatrate.wiki",
    "support": {
        "issues": "https://github.com/mrkcntrmn/flatrate-flarum-wiki-context/issues",
        "source": "https://github.com/mrkcntrmn/flatrate-flarum-wiki-context"
    },
    "require": {
        "php": "^8.1",
        "flarum/core": "^1.8.19",
        "flarum/tags": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "illuminate/database": "^8.83"
    },
    "autoload": {
        "psr-4": {
            "FlatRate\\WikiContext\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FlatRate\\WikiContext\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "flarum-extension": {
            "title": "FlatRate Wiki Context",
            "category": "feature",
            "icon": {
                "name": "fas fa-project-diagram",
                "backgroundColor": "#111827",
                "color": "#ffffff"
            }
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
